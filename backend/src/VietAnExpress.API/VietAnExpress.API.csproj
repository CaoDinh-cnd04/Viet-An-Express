  <ItemGroup>
    <ProjectReference Include="..\BuildingBlocks\VietAnExpress.SharedKernel\VietAnExpress.SharedKernel.csproj" />
    <ProjectReference Include="..\Modules\Identity\VietAnExpress.Identity\VietAnExpress.Identity.csproj" />
